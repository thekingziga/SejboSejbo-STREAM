# ==============================================================================
# Sejbosejbo Live (SEJBOSEJBO.TV) Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Core Settings ---
NODE_ENV=production
SITE_URL=http://localhost:3030
SITE_NAME=SEJBOSEJBO.TV
HOST_PORT=3030
PORT=3030
SITE_TIMEZONE=Europe/Ljubljana

# --- Security (REQUIRED: set random secrets for production) ---
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# --- RTMP / HLS Streaming Relay (Optional: OBS Studio / Owncast / MediaMTX) ---
# Public RTMP ingest URL displayed in /studio
RTMP_PUBLIC_URL=rtmp://localhost:1935/live
# Optional default external HLS (.m3u8) stream URL for the main channel
DEFAULT_HLS_URL=

# --- Media & Clip Uploads ---
CLIP_UPLOAD_LIMIT_MB=250
